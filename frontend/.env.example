# ==========================================
# MEDORA — ENVIRONMENT CONFIGURATION EXAMPLE
# ==========================================
# Instructions:
# 1. Copy this file and rename it to `.env`:
#    cp .env.example .env
# 2. Replace the placeholder values below with your actual API keys.
# 3. Save the file. Vite will automatically load these variables.

# ------------------------------------------
# 1. GROQ AI API KEYS (REQUIRED)
# ------------------------------------------
# Get your free Groq API keys at: https://console.groq.com/keys
# You can use the same API key for both or separate keys if preferred.

VITE_HEALTH_PREDICT_API_KEY=gsk_your_groq_api_key_here
VITE_FIND_DOCTOR_API_KEY=gsk_your_groq_api_key_here

# Groq API Endpoint & Model (Defaults are provided in code, but can be overridden here)
VITE_GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------
# 2. CLOUDINARY CONFIGURATION (OPTIONAL)
# ------------------------------------------
# Required only if you want to enable profile image uploads.
# Get your credentials at: https://cloudinary.com/

VITE_CLOUD_NAME=your_cloudinary_cloud_name
VITE_UPLOAD_PRESET=your_cloudinary_upload_preset
